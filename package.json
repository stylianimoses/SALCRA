{
  "name": "salcra",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/output.css --postcss",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/output.css --watch --postcss",
    "sync-layout": "node sync-layout.js",
    "dev": "concurrently \"npm run watch:css\" \"browser-sync start --server --files 'css/output.css, *.html, about-us/**/*.html, benefits/**/*.html, business/**/*.html, media-centre/**/*.html, sustainability/**/*.html, js/**/*.js'\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.3",
    "puppeteer-core": "^25.9.0"
  }
}
